# Local development uses data/db.json and does not require environment variables.
# Copy this file to .env to enable optional integrations.

# Optional PostgreSQL connection. Use either DATABASE_URL or the PG* fields.
# PostgreSQL is used for the project tracker; other app data uses data/db.json.
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/lodonsoft_db
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your-password
# PGDATABASE=lodonsoft_db
# PGSSL=false
